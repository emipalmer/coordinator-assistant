# Mac bridge (services/bridge). Copy to .env; never commit .env.
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=
BRIDGE_PORT=8787
# Comma-separated E.164 numbers allowed to talk to the assistant
COORDINATOR_ALLOWLIST=+16105550100
# Filled in after `cdk deploy`
INGRESS_URL=
OUTBOUND_QUEUE_URL=
BRIDGE_SHARED_SECRET=
AWS_REGION=us-east-1
