# Mac bridge (services/bridge). Copy to .env; never commit .env.
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=
BRIDGE_PORT=8787
# Comma-separated E.164 numbers allowed to talk to the assistant
COORDINATOR_ALLOWLIST=+16105550100
# Filled in after `cdk deploy`
INGRESS_URL=
OUTBOUND_QUEUE_URL=
BRIDGE_SHARED_SECRET=
AWS_REGION=us-east-1
# bedrock (default) or anthropic (stopgap while Bedrock access is pending)
LLM_PROVIDER=bedrock
MONGODB_URI=
ANTHROPIC_API_KEY=
# Set from cdk-outputs.json (enables photo intake)
FILES_BUCKET=
# Google OAuth client (Web application). Copied to SSM /coord/google-oauth-client; not read at runtime from here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
