# Personal assistant. Copy to .env; never commit .env. `npm run secrets` copies the keys into SSM.
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=
BRIDGE_PORT=8787
# Comma-separated E.164 numbers allowed to talk to the assistant (the first gets the morning briefing)
ALLOWLIST=+16105550100
# Filled in from cdk-outputs.json after `npm run deploy`
INGRESS_URL=
OUTBOUND_QUEUE_URL=
FILES_BUCKET=
# Generated by `npm run secrets` if empty
BRIDGE_SHARED_SECRET=
AWS_REGION=us-east-1
# Bridge's own AWS key profile (README: "Bridge AWS key"). Leave empty to use your normal sign-in.
BRIDGE_AWS_PROFILE=
# anthropic (default) or bedrock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MONGODB_URI=
# Google OAuth client (Web application); redirect URI = stack output GoogleRedirectUri
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Canvas: Calendar > "Calendar Feed" link (treat it like a password)
CANVAS_FEED_URL=
