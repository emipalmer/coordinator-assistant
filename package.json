{
  "name": "coordinator-assistant",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "infra"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "bridge": "npm run start -w services/bridge",
    "bridge:forever": "./scripts/run-bridge.sh",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "say": "tsx --env-file=.env scripts/say.ts",
    "security-check": "tsx --env-file=.env scripts/security-check.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1149.0",
    "@aws-sdk/client-sqs": "^3.1149.0",
    "@aws-sdk/client-ssm": "^3.1149.0",
    "@types/node": "^22.10.0",
    "mongodb": "^7.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
